# --- CLIENT (exposed to the app — safe to ship) ---
EXPO_PUBLIC_SUPABASE_URL=https://qbzjaseetusewxnfgpes.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_kZLZNdpaZznMoXjqaMgjmQ_3SeAAmAC
# The privacy policy and terms the paywall links to (Apple requires both).
# Empty means https://postaspanish.com/privacy and https://postaspanish.com/terms.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
# Where the course's clips are served from, when not the Supabase `audio`
# bucket (e.g. https://<bucket>.s3.amazonaws.com). Same folders underneath.
# Edge functions read the same value as the AUDIO_URL secret.
EXPO_PUBLIC_AUDIO_URL=

# --- EDGE FUNCTION SECRETS (set via `supabase secrets set` — never committed) ---
# Set with:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set CRON_SECRET=$(openssl rand -hex 32)
#
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by Supabase
# into edge functions — don't set them manually.)
ANTHROPIC_API_KEY=
CRON_SECRET=
# Billing, straight with the stores (no keys in the app: the product ids are in
# src/lib/billing-shared.ts). Apple needs no secret. Google needs two:
#   supabase secrets set GOOGLE_PLAY_SERVICE_ACCOUNT="$(cat service-account.json)"
#   supabase secrets set GOOGLE_PUBSUB_TOKEN=$(openssl rand -hex 32)
# How to wire each store is at the top of supabase/functions/apple-notifications
# and google-notifications.
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PUBSUB_TOKEN=
# Email (supabase/functions/_shared/email.ts — not called from anywhere yet).
# A Resend key with "Sending access" only, from postaspanish.com:
#   supabase secrets set RESEND_API_KEY=re_...
RESEND_API_KEY=

# --- AUTHORING SCRIPTS (this machine only — never shipped, never a secret the
#     app needs) ---
# ANTHROPIC_API_KEY above doubles as the content pipeline's key.
# ELEVENLABS_API_KEY records the course: `npm run course:tts`. Make it at
# elevenlabs.io → Developers → API Keys, restricted to Text to Speech (access)
# and Voices (read) — nothing else is called.
ELEVENLABS_API_KEY=

# --- POSTGRES SETTINGS for pg_cron (set once via SQL Editor) ---
# alter database postgres set app.functions_url = 'https://qbzjaseetusewxnfgpes.supabase.co/functions/v1';
# alter database postgres set app.cron_secret   = '<same value as CRON_SECRET above>';

# Mascot image generation (scripts/mascot/generate.mjs)
GEMINI_API_KEY=
