# What EAS Build uploads. Same as .gitignore, plus the folders the app never
# imports: course sources and snapshots, the Remotion videos, docs and the
# server side, and the git history itself. Builds run with EAS_NO_VCS=1
# (npm run build:ios), so this file is the whole list: ~550 MB down to ~80 MB.
# (When .easignore exists EAS stops reading .gitignore, so its rules are here too.)

.git/

# --- from .gitignore
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.env
.env*.local
# Anchored: a bare ios/ also dropped assets/images/widget/ios/, so the widget scenes never reached the build.
/ios/
/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
.DS_Store
*.pem
npm-debug.*
yarn-debug.*
yarn-error.*
.kotlin/
.metro-health-check*
*.tsbuildinfo
*.log
.vercel
.course-work/

# --- not part of the app build
content/
social/
docs/
research_notes/
supabase/
scripts/
.agents/
.claude/
reports/
