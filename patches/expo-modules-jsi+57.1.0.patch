+
+/// An immutable value carried across isolation boundaries without checking — a struct, so
+/// unlike `NonisolatedUnsafeVar` it costs no allocation on hot paths.
+internal struct NonisolatedUnsafeLet<Value>: @unchecked Sendable {
+  let value: Value
+
+  init(_ value: Value) {
+    self.value = value
+  }
+}
