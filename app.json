{
  "expo": {
    "name": "Posta",
    "slug": "posta",
    "owner": "swellyo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "posta",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7EFE6",
    "primaryColor": "#B44A60",
    "ios": {
      "bundleIdentifier": "app.posta.ios",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "appleTeamId": "5AANVGL84P",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.posta.ios"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.posta.android",
      "adaptiveIcon": {
        "backgroundColor": "#F7EFE6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#F7EFE6",
      "backgroundColor": "#F7EFE6"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7EFE6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Posta uses the microphone so you can talk with Pancho and practice saying phrases out loud.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B44A60",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Posta lets you attach screenshots from your photos when you send feedback.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-build-properties",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./targets/widget/assets/Gabarito_900Black.ttf",
            "./targets/widget/assets/Figtree_700Bold.ttf",
            "./targets/widget/assets/Figtree_800ExtraBold.ttf"
          ],
          "widgets": [
            {
              "name": "PostaSmall",
              "label": "Posta",
              "description": "Your streak and the Argentine word of the day.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PostaMedium",
              "label": "Posta, wide",
              "description": "Your streak and the Argentine word of the day, with an example.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-iap",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "app.posta.ios.widget",
                  "targetName": "PostaWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.posta.ios"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "app.posta.ios.widget",
                  "targetName": "PostaWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.posta.ios"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "1fc7cd1b-48b6-4c12-9c09-e7b7953f0910"
      }
    }
  }
}
