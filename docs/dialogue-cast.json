    "s2": "m"
  },
  "e035a9e1-d1ec-5ad6-ba92-a4de13adace8": {
    "es": "—¿Sos de Inglaterra? —No, soy alemán.",
    "s1": null,
    "s2": "m"
  },
  "e196e792-80b8-5a13-b92a-ae5f4c251353": {
    "es": "—¿Sos inglés? —No, yanqui.",
    "s1": null,
    "s2": "m"
  },
  "e28498bc-4bda-5a13-ba1c-f85bf4cd0d8c": {
    "es": "—Perdón, ¿vos sos Sofi? —Sí, soy yo.",
    "s1": null,
    "s2": "f"
  },
  "e2b0fc74-d1c2-5192-9a8a-73875015d217": {
    "es": "—¿Estás cansado? —En realidad, no.",
    "s1": null,
    "s2": "m"
  },
  "e6a0c519-74cb-5460-b54d-291829f9e57b": {
    "es": "—¿Ascensor o escalera? —Escalera, estoy apurado.",
    "s1": null,
    "s2": "m"
  },
  "e85645ca-e1d3-564a-809f-49b76ab57a2d": {
    "es": "—¡Gracias, Mati! —De nada.",
    "s1": null,
    "s2": "m"
  },
  "e8a57b29-b965-5b94-9160-98733ac41f31": {
    "es": "—Gracias por el cargador. —De nada, Mati.",
    "s1": "m",
    "s2": null
  },
  "ea60e830-2728-5765-82fe-576bf33cb489": {
    "es": "—¿Te pusiste nervioso? —Sí, re nervioso.",
    "s1": null,
    "s2": "m"
  },
  "ea85939b-b107-5522-88d1-48d8217a1cce": {
    "es": "—Yo soy alemán, ¿y vos? —Chileno.",
    "s1": "m",
    "s2": "m"
  },
  "ec222e9b-92c8-5713-accb-66427de0015a": {
    "es": "—¿Te vas solo a Bariloche? —Sí, me la juego.",
    "s1": null,
    "s2": "m"
  },
  "eea991fc-7636-5f4b-b43c-2bae78b75e14": {
    "es": "—Permiso, doña Elena. —Pasá, querido, pasá.",
    "s1": "m",
    "s2": "f"
  },
  "f497d8f0-5473-53f7-92d0-6c077c4e2389": {
    "es": "—¿Sos estudiante extranjera? —No, soy profe.",
    "s1": null,
    "s2": "f"
  },
  "f7ba5953-ae2f-5eb5-9d81-f282bb1566e7": {
    "es": "—¿Sofi? —No, Lucía.",
    "s1": null,
    "s2": "f"
  },
  "fbae0ca1-1462-576c-afce-f1114925af81": {
    "es": "—¿Qué hiciste? —Nada, me quedé helado.",
    "s1": null,
    "s2": "m"
  },
  "fbe3a614-55b6-5efe-ab87-b19ff59fc8e8": {
    "es": "—¿Viajaste solo? —No, con mi novia.",
    "s1": null,
    "s2": "m"
  },
  "fcf7c3c7-3d26-5e9a-b04b-df650c63ff96": {
    "es": "—¿Por qué estás contenta? —Porque tengo un gato.",
    "s1": null,
    "s2": "f"
  },
  "fcf9f3c8-98f2-55bd-9b07-ead30c720bc0": {
    "es": "—¿Cuántas materias tenés? —Seis, y estoy cansado.",
    "s1": null,
    "s2": "m"
  }
}
